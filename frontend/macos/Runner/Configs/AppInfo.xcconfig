// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// Bundle / executable name — no spaces (Flutter's `open` breaks on spaces,
// which also prevents the Dock from binding AppIcon during `flutter run`).
// User-visible title stays "Robot Studio" via CFBundleDisplayName + window title.
PRODUCT_NAME = RobotStudio

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.robotstudio.app

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Robot Studio. All rights reserved.
